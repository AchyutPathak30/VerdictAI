# Copy to .env; docker compose loads it into the API container.

ENVIRONMENT=development
JWT_SECRET=change-me-before-deploying

# Optional: turns on Gemini explanations. Left empty, the deterministic fallback is used.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Persist the in-memory store to disk so case data survives restarts (R-05).
# docker-compose sets this to a mounted volume; leave empty for pure in-memory.
DB_PERSIST_PATH=

# Read by DatabaseConfig. Storage is the in-memory simulation (optionally
# snapshotted via DB_PERSIST_PATH); these matter once live PostgreSQL/MongoDB
# drivers are wired in.
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=verdictai_db
PG_USER=postgres
PG_PASSWORD=postgres
MONGO_URI=mongodb://localhost:27017
MONGO_DATABASE=verdictai_evidence
