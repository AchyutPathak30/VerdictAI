# ==============================================================================
# VerdictAI Platform Environment Configuration
# Author: Nirav Kachhiya (Project Lead & Database Architect)
# ==============================================================================

ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
API_V1_PREFIX=/api/v1

# Security & Authentication (SRS NFR-14 & FR-04)
JWT_SECRET=verdictai-insecure-secret-key-change-in-prod
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Per-Client Rate Limiting (SRS NFR-08)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=120
RATE_LIMIT_BURST=30

# Dual-Database Storage Architecture (SRS FR-01 & Architecture Standard)
# Set IN_MEMORY_DB=true for isolated in-memory testing or demo mode
# Set IN_MEMORY_DB=false to connect to live PostgreSQL & MongoDB instances
IN_MEMORY_DB=true

# PostgreSQL Relational Store (ACID Transactions & Dispute Case State)
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=verdictai_db
PG_USER=postgres
PG_PASSWORD=postgres

# MongoDB Polymorphic Evidence Store (SHA-256 Hashed Documents & JSON Payloads)
MONGO_URI=mongodb://localhost:27017
MONGO_DATABASE=verdictai_evidence

# LLM Reasoning & Counterfactual Generation (Phase 5 - Optional Gemini 1.5)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
